#!/command/with-contenv sh
# HUD de bolsillo (app del iPhone). s6 lo arranca con el contenedor y lo relanza si se cae.
export HOME=/opt/data
# el contenedor va en UTC: los programas que lanza (tablero, sistema, biblioteca…) cuentan «hoy» en hora de Madrid
export TZ=Europe/Madrid
cd /opt/data
exec s6-setuidgid hermes node /opt/data/hud/movil/server.mjs
