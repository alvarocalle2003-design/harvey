#!/bin/sh
# Claude Code para Harvey: usa el token de la suscripción del señor (/opt/data/.claude-token, lo guarda él con
# harvey-tools/claude-para-harvey.ps1). Si se recrea el contenedor, rehacer: ln -sf /opt/data/bin/claude /usr/local/bin/claude
[ -r /opt/data/.claude-token ] && CLAUDE_CODE_OAUTH_TOKEN="$(tr -d '[:space:]' < /opt/data/.claude-token)" && export CLAUDE_CODE_OAUTH_TOKEN
# Una sola carpeta de configuración (skills, complementos, CLAUDE.md), la use quien la use
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-/opt/data/home/.claude}"
exec /opt/data/.npm-global/bin/claude "$@"
